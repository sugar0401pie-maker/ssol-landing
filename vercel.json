{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ssolwellnesshouse.com"
        }
      ],
      "destination": "https://www.ssolwellnesshouse.com/:path*",
      "permanent": true
    },
    {
      "source": "/ssowella.html",
      "destination": "/about.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/postoffice",
      "destination": "/api/postoffice"
    },
    {
      "source": "/postoffice/:n(\\d+)",
      "destination": "/api/postoffice?n=:n"
    },
    {
      "source": "/postoffice-sitemap.xml",
      "destination": "/api/postoffice?sitemap=1"
    }
  ]
}
